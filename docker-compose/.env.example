# Copy to docker-compose/.env (git-ignored) and fill in the values.

# MariaDB container
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=StarInventory
MARIADB_USER=starinventory
MARIADB_PASSWORD=change-me

# OIDC issuer (trailing slash required; the API fetches ${JWT_ISSUER}jwks/ on startup) and client id (token audience)
JWT_ISSUER=https://auth.example.com/application/o/star-inventory/
JWT_CLIENT_ID=your-client-id

# Development enables Swagger UI on http://localhost:8080/
ASPNETCORE_ENVIRONMENT=Development
